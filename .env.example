PORT=3000
SESSION_SECRET=change-this-to-a-long-random-string
# 프록시(Caddy/nginx/Render) 뒤에서 HTTPS로 서비스할 때 1로 설정
TRUST_PROXY=0
# 세션 쿠키에 secure 플래그를 강제할지 (HTTPS 배포 시 1)
COOKIE_SECURE=0
# 배치도 이미지 1개당 최대 업로드 용량(MB)
MAX_IMAGE_MB=20
# data/, uploads/ 를 저장할 기준 경로. Render 배포 시 영구 디스크 마운트 경로로 지정
# (비워두면 프로젝트 폴더 아래 data/, uploads/ 사용)
STORAGE_DIR=
# 설정하면 서버 최초 실행 시 해당 아이디의 관리자 계정을 자동 생성 (이미 존재하면 무시됨)
# ADMIN_PASSWORD는 8자 이상이어야 함
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_DISPLAY_NAME=
